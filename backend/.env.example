NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-unique-local-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-local-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-local-admin-password
